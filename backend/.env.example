# PrintShop Backend Production Configuration (.env)

# Application settings
APP_NAME=PrintShop Automation
FRONTEND_URL=https://your-printshop.vercel.app
ALLOWED_ORIGINS=https://your-printshop.vercel.app

# Print mode in cloud ("simulate" recommended on Render/Cloud)
PRINT_MODE=simulate
SIMULATED_SECONDS_PER_PAGE=0.5
DELETE_FILE_AFTER_PRINT=true
FILE_RETENTION_HOURS=24

# Payment Gateway (Optional / Live Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
